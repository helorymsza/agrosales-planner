# 1. Importação
import pandas as pd

# 2. Carregamento de dados
df = pd.read_csv('data/sample_data.csv')

# 3. Criação das métricas
df['gap_ratio'] = df['target_gap'] / df['target']

# 4. Priority Score (exemplo simples)
df['priority_score'] = (
    0.4 * df['gap_ratio'] +
    0.3 * df['sales'] +
    0.2 * df['seasonality'] +
    0.1 * df['stock']
)

# 5. Resultado
df.sort_values(by='priority_score', ascending=False).head()
